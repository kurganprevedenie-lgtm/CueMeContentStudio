# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=

# TikTok for Developers — Content Posting API (черновик, privacy_level=SELF_ONLY,
# приложение ещё не прошло app review)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Должен точно совпадать со значением, указанным в настройках приложения
# в TikTok for Developers (redirect URI)
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback

# Ключ шифрования для хранения TikTok access/refresh токенов на диске
# (apps/web/.data/tiktok-tokens.enc, в .gitignore). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
