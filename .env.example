# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=

# TikTok for Developers — Content Posting API (черновик во "Входящие"
# TikTok-аккаунта, scope video.upload — не требует app review)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Должен точно совпадать со значением, указанным в настройках приложения
# в TikTok for Developers (redirect URI). TikTok требует https даже для
# localhost — запускай сервер через `pnpm --filter web dev:https`
# (next dev --experimental-https, самоподписанный сертификат)
TIKTOK_REDIRECT_URI=https://localhost:3000/api/tiktok/callback

# Ключ шифрования для хранения TikTok/YouTube access/refresh токенов на
# диске (apps/web/.data/*.enc, в .gitignore). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# YouTube (Google Cloud Console → OAuth Client ID, тип Web application,
# scope youtube.upload). Redirect URI должен точно совпадать со значением
# в настройках OAuth-клиента. В отличие от TikTok, Google разрешает обычный
# http://localhost без сертификата — `pnpm dev` достаточно, dev:https не нужен.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/callback
