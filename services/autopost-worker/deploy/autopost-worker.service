[Unit]
Description=CueMe autopost-worker — scheduled TikTok/YouTube/Instagram publisher from Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Как и cueme-bot — от обычного пользователя, не отдельного системного
# аккаунта (см. deploy/update.sh, повторяет схему ~/CueMe/auto_update.sh)
User=nikola
Group=nikola
WorkingDirectory=/home/nikola/CueMeContentStudio/services/autopost-worker
# Без EnvironmentFile= — src/config.ts сам грузит .env через dotenv при
# старте, systemd-директиве тут делать нечего (на этом сервере она к тому же
# упирается в SELinux-denial на файлы в домашней папке пользователя)
#
# node — явным абсолютным путём, не через шебанг/PATH: Node здесь стоит через
# nvm (в домашней папке пользователя), systemd видит только системный PATH
# (/usr/bin и т.п.) и не находит nvm-версию node сам по себе (`which node`
# на сервере — единственный надёжный способ узнать актуальный путь, версия
# может смениться при следующем `nvm install`, тогда путь надо будет поправить)
ExecStart=/home/nikola/.nvm/versions/node/v24.18.0/bin/node /home/nikola/CueMeContentStudio/services/autopost-worker/node_modules/.bin/tsx src/index.ts
Restart=on-failure
RestartSec=10

# Лёгкий процесс — почти всё время спит между опросами Drive и проверками
# расписания, изредка недолго грузит/льёт видео. Разумный потолок на случай
# утечки или зависшей загрузки, а не расчёт на постоянную нагрузку.
MemoryMax=256M
CPUQuota=25%

# Базовая изоляция от cueme-bot и остальной системы — процессу нужен доступ
# на запись только в свои рабочие каталоги, больше никуда.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/nikola/CueMeContentStudio/services/autopost-worker/data
ReadWritePaths=/home/nikola/CueMeContentStudio/services/autopost-worker/tmp
ReadWritePaths=/home/nikola/CueMeContentStudio/services/autopost-worker/.data
ReadWritePaths=/home/nikola/CueMeContentStudio/services/autopost-worker/autopost-worker.log

[Install]
WantedBy=multi-user.target
