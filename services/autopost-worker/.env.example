# Google Drive — папка, куда Content Studio (или ты вручную) кладёт готовые
# .mp4. ID — часть ссылки на папку: drive.google.com/drive/folders/<ЭТОТ_ID>
GDRIVE_FOLDER_ID=
# Путь к JSON-ключу service account (Google Cloud Console → IAM → Service
# Accounts → Keys). Папку GDRIVE_FOLDER_ID нужно расшарить с client_email
# из этого файла (роль — Editor), иначе воркер её не увидит.
# Относительный путь — считается от корня services/autopost-worker.
GDRIVE_SERVICE_ACCOUNT_KEY_PATH=service-account.json
# Как часто проверять папку на новые файлы, минуты
GDRIVE_POLL_INTERVAL_MIN=5

# Пути к расписанию/очереди/логу — относительные считаются от корня
# services/autopost-worker, можно указать и абсолютные (например /var/log/...)
SCHEDULE_CONFIG_PATH=config/schedule.json
STATE_FILE_PATH=data/state.json
TEMP_DIR=tmp
LOG_FILE_PATH=autopost-worker.log

# Какие площадки публикуем — можно временно выключить те, что ещё не подключены
ENABLE_TIKTOK=true
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true

# Мультиаккаунт: список id аккаунтов через запятую, без пробелов — воркер
# сам не выбирает аккаунты (нет UI), каждое видео из Drive уйдёт на ВСЕ
# перечисленные здесь. id — со страницы /accounts в Content Studio (в самом
# конце ссылки на "Отключить"/"Переподключить" каждого аккаунта, или в
# консоли: F12 → Network при загрузке /accounts). Токены этих аккаунтов
# (apps/web/.data/tiktok-{id}.enc / youtube-{id}.enc) нужно скопировать на
# сервер воркера — см. AUTOPOST_WORKER_SETUP.md, шаг про перенос токенов.
# Если платформа включена (ENABLE_TIKTOK=true), а список пуст — воркер
# запустится, но напишет в лог ошибку и будет пропускать эту площадку.
TIKTOK_ACCOUNT_IDS=
YOUTUBE_ACCOUNT_IDS=

# Подпись/заголовок — {filename} подставляется именем файла в Drive без
# расширения (например "aunt-drama-part3.mp4" → "aunt-drama-part3")
WORKER_CAPTION_TEMPLATE={filename}
# YouTube: public/unlisted/private — как и в UI Content Studio, по умолчанию unlisted
YOUTUBE_PRIVACY_STATUS=unlisted

# --- Дальше — те же переменные, что в .env.example Content Studio ---
# (packages/publish-clients читает их точно так же). Значения ДОЛЖНЫ быть
# теми же самыми, что у уже подключённых аккаунтов — это не новый логин, а
# продолжение уже существующего подключения. См. AUTOPOST_WORKER_SETUP.md.

# Ключ шифрования токенов — ОБЯЗАН совпадать со значением в .env Content
# Studio, иначе скопированные *.enc файлы не расшифруются.
TOKEN_ENCRYPTION_KEY=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_PUBLISH_MODE=inbox

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
